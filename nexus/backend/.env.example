# ============================================
# NEXUS BACKEND - ENVIRONMENT VARIABLES
# Fill in your own values. DO NOT COMMIT real secrets.
# ============================================

# ----- Server -----
NODE_ENV=development
PORT=5000

# ----- Database -----
DATABASE_URL=mongodb://localhost:27017/nexus

# ----- JWT -----
JWT_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ----- Cloudinary -----
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ----- Google Gemini (Rizz AI) -----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ----- Email (SMTP / Gmail App Password) -----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=NEXUS <your_gmail_address@gmail.com>

# ----- Socket -----
SOCKET_URL=http://localhost:5000

# ----- URLs -----
APP_URL=http://localhost:5000
MOBILE_APP_URL=nexus://

# ----- OTP -----
OTP_LENGTH=6
OTP_EXPIRATION_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
